# --- Secrets / environment -------------------------------------------------
# Never commit a real .env. .env.example documents the required variables.
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
coverage.xml

# --- Node / frontend -------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Editors / OS ----------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Logs / misc -----------------------------------------------------------
*.log

# --- Assessment source material --------------------------------------------
# Third-party briefs and the university execution plan, kept in the working
# tree for reference only. They are not this project's work and must never be
# redistributed, so they are excluded at the repository root. Nested paths such
# as docs/*.pdf are unaffected.
/*.pdf
