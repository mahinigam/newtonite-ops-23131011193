# Newtonite backend configuration.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# development | test | production
ENVIRONMENT=development

# PostgreSQL connection used by the API, Alembic and the seed script.
# The credentials below are local development values only. They match the
# `newtonite` role created in README.md step 2 and the docker-compose service
# (which listens on host port 5433).
DATABASE_URL=postgresql+asyncpg://newtonite:newtonite_dev_pw@127.0.0.1:5432/newtonite

# Separate database used by the integration test suite. Tests truncate tables
# in this database, so it must never point at a database holding real data.
TEST_DATABASE_URL=postgresql+asyncpg://newtonite:newtonite_dev_pw@127.0.0.1:5432/newtonite_test

# Session lifetime. A session is rejected once either limit is exceeded.
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_HOURS=2

# Browser origins allowed to call the API (comma separated). The Docker setup serves
# the web app on port 8080, so it is listed alongside the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# The outbox worker. Notifications are queued in the same transaction as the change that
# caused them, then delivered by `python -m app.worker`. These are the only knobs: how
# many events to take at once, how long to wait when the queue is empty, and how many
# attempts before an event is marked failed.
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=5

LOG_LEVEL=INFO
